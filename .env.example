# Copy to .env and fill in. Never commit .env.

# Postgres (Guacamole metadata only — not your Windows login)
POSTGRES_USER=guacamole
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=guacamole_db

# Bind Guacamole to loopback on the ThinkCentre. Cloudflare Tunnel reaches it
# on the Docker network; nothing else should publish this port.
GUACAMOLE_BIND=127.0.0.1
GUACAMOLE_PORT=8080

# Named Cloudflare Tunnel token from Zero Trust → Networks → Tunnels.
# Leave empty until you run scripts/setup-tunnel.ps1
CLOUDFLARE_TUNNEL_TOKEN=

# Public hostname you will attach to the tunnel (documentation only).
# Example: pc.example.com
CLOUDFLARE_HOSTNAME=
